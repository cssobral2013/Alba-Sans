features = (
{
code = "# Access All Alternates

#> feature
  feature tnum;
  feature locl;
  feature sups;
  feature pnum;
#< feature";
tag = aalt;
},
{
code = "# Tabular Figures

#> feature
  sub Euro by Euro.tf;
  sub bitcoin by bitcoin.tf;
  sub cedi by cedi.tf;
  sub cent by cent.tf;
  sub colon by colon.tf;
  sub colonmonetary by colonmonetary.tf;
  sub comma by comma.tf;
  sub currency by currency.tf;
  sub dollar by dollar.tf;
  sub dong by dong.tf;
  sub eight by eight.tf;
  sub five by five.tf;
  sub four by four.tf;
  sub indianrupee by indianrupee.tf;
  sub lira by lira.tf;
  sub naira by naira.tf;
  sub nine by nine.tf;
  sub one by one.tf;
  sub period by period.tf;
  sub peseta by peseta.tf;
  sub ruble by ruble.tf;
  sub rupee by rupee.tf;
  sub semicolon by semicolon.tf;
  sub seven by seven.tf;
  sub six by six.tf;
  sub sterling by sterling.tf;
  sub three by three.tf;
  sub turkishlira by turkishlira.tf;
  sub two by two.tf;
  sub won by won.tf;
  sub yen by yen.tf;
  sub zero by zero.tf;
#< feature";
tag = tnum;
},
{
code = "# Localized Forms

#> feature
  script latn; # Latin
  language MOL; # Moldavian
  sub Scedilla by Scommaaccent;
  sub Tcedilla by Tcommaaccent;
  sub scedilla by scommaaccent;
  sub tcedilla by tcommaaccent;

  language ROM; # Romanian
  sub Scedilla by Scommaaccent;
  sub Tcedilla by Tcommaaccent;
  sub scedilla by scommaaccent;
  sub tcedilla by tcommaaccent;

  language TRK; # Turkish
  sub i by i.loclTRK;
  language AZE; # Turkish
  sub i by i.loclTRK;
  language KAZ; # Turkish
  sub i by i.loclTRK;
  language CRT; # Turkish
  sub i by i.loclTRK;
  language TAT; # Turkish
  sub i by i.loclTRK;

  language CAT;
  sub L' periodcentered' L by Ldot;
  sub l' periodcentered' l by ldot;

  language NLD;
  sub I J by IJ;
  sub Iacute J by IJacute.loclNLD;
  sub i j by ij;
  sub iacute j by ijacute.loclNLD;
#< feature";
tag = locl;
},
{
code = "# Superscript

#> feature
  sub eight by eight.superior;
  sub five by five.superior;
  sub four by four.superior;
  sub nine by nine.superior;
  sub one by one.superior;
  sub seven by seven.superior;
  sub six by six.superior;
  sub three by three.superior;
  sub two by two.superior;
  sub zero by zero.superior;
#< feature";
tag = sups;
},
{
code = "# Subscript

#> feature
  sub eight by eight.inferior;
  sub five by five.inferior;
  sub four by four.inferior;
  sub nine by nine.inferior;
  sub one by one.inferior;
  sub seven by seven.inferior;
  sub six by six.inferior;
  sub three by three.inferior;
  sub two by two.inferior;
  sub zero by zero.inferior;
#< feature";
tag = subs;
},
{
code = "# Scientific Inferiors

#> feature
  sub eight by eight.inferior;
  sub five by five.inferior;
  sub four by four.inferior;
  sub nine by nine.inferior;
  sub one by one.inferior;
  sub seven by seven.inferior;
  sub six by six.inferior;
  sub three by three.inferior;
  sub two by two.inferior;
  sub zero by zero.inferior;
#< feature";
tag = sinf;
},
{
code = "# Fractions

#> feature
lookup frac_precomposed {

  sub one slash four by onequarter;
  sub one slash two by onehalf;
  sub three slash four by threequarters;
  sub one slash eight by oneeighth;
  sub three slash eight by threeeighths;
  sub five slash eight by fiveeighths;
  sub seven slash eight by seveneighths;
  sub one fraction four by onequarter;
  sub one fraction two by onehalf;
  sub three fraction four by threequarters;
  sub one fraction eight by oneeighth;
  sub three fraction eight by threeeighths;
  sub five fraction eight by fiveeighths;
  sub seven fraction eight by seveneighths;
} frac_precomposed;
#< feature";
tag = frac;
},
{
code = "# Ordinals

#> feature
  sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;
  sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;
#< feature";
tag = ordn;
},
{
code = "# Proportional Figures

#> feature
  sub Euro.tf by Euro;
  sub bitcoin.tf by bitcoin;
  sub cedi.tf by cedi;
  sub cent.tf by cent;
  sub colon.tf by colon;
  sub colonmonetary.tf by colonmonetary;
  sub comma.tf by comma;
  sub currency.tf by currency;
  sub dollar.tf by dollar;
  sub dong.tf by dong;
  sub eight.tf by eight;
  sub five.tf by five;
  sub four.tf by four;
  sub indianrupee.tf by indianrupee;
  sub lira.tf by lira;
  sub naira.tf by naira;
  sub nine.tf by nine;
  sub one.tf by one;
  sub period.tf by period;
  sub peseta.tf by peseta;
  sub ruble.tf by ruble;
  sub rupee.tf by rupee;
  sub semicolon.tf by semicolon;
  sub seven.tf by seven;
  sub six.tf by six;
  sub sterling.tf by sterling;
  sub three.tf by three;
  sub turkishlira.tf by turkishlira;
  sub two.tf by two;
  sub won.tf by won;
  sub yen.tf by yen;
  sub zero.tf by zero;
#< feature";
tag = pnum;
},
{
code = "# Standard Ligatures

#> feature
  sub f f by f_f;
  sub f i by fi;
  sub f l by fl;
  sub f f i by f_f_i;
  sub f f l by f_f_l;
#< feature";
tag = liga;
},
{
code = "# Contextual Alternates
   sub @calt [colon colon.tf]' @calt by [uniEE01 uniEE01];";
tag = calt;
},
{
code = "# Stylistic Set 01–20

#> feature
  sub Q by Q.ss01;
#< feature";
tag = ss01;
}
